# Copy to .env and fill in. Never commit the real file.
APP_HOST=lnkmx.my
API_HOST=api.lnkmx.my
APP_ORIGIN=https://lnkmx.my
API_ORIGIN=https://api.lnkmx.my

# Must equal ANON_KEY from supabase/docker/.env (generated from your JWT_SECRET)
ANON_KEY=

# Old database connection (for export) and new one (for import)
SOURCE_DB_URL=
TARGET_DB_URL=postgres://postgres:CHANGE_ME@localhost:5432/postgres

# Secrets for edge functions (put into supabase/docker/.env as well)
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD_1=
ROBOKASSA_PASSWORD_2=
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
