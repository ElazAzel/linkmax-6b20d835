# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-browser-publishable-key

# Optional public integrations
VITE_APP_DOMAIN=localhost:8080
VITE_ENABLE_REMOTE_TRANSLATIONS=false
VITE_LOVABLE_CONNECTOR_POSTHOG_API_KEY=
VITE_LOVABLE_CONNECTOR_POSTHOG_REGION=us
VITE_PAYMENTS_CLIENT_TOKEN=
VITE_SENTRY_DSN=
VITE_TELEGRAM_BOT_NAME=
VITE_TURNSTILE_SITE_KEY=

# Test-only account for an isolated staging project. Never use production users.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# Server-side values belong in GitHub environment secrets, not in this file:
# SUPABASE_ACCESS_TOKEN, SUPABASE_DB_PASSWORD, CLOUDFLARE_API_TOKEN,
# CLOUDFLARE_ACCOUNT_ID, CF_WORKER_SUPABASE_PROJECT,
# CF_WORKER_SUPABASE_ANON_KEY.
