{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "start": "vite preview",
    "lint": "eslint .",
    "lint:json": "node -e \"require('fs').mkdirSync('tmp',{recursive:true})\" && eslint . -f json -o tmp/eslint-results.json",
    "lint:ratchet": "npm run lint:json && node scripts/eslint-warning-ratchet.mjs --input tmp/eslint-results.json",
    "lint:i18n": "node scripts/i18n-literal-baseline-check.mjs",
    "analyze:deps": "depcruise --config config/dependency-cruiser.cjs --output-type text src",
    "analyze:cycles": "depcruise --config config/dependency-cruiser.cjs --output-type err src",
    "analyze:layers": "depcruise --config config/dependency-cruiser.cjs --output-type err src",
    "analyze:unused": "node scripts/knip-baseline-check.mjs",
    "quality:gate": "npm run analyze:cycles && npm run analyze:layers && npm run analyze:unused",
    "quality:check": "npm run lint:ratchet && npm run lint:i18n && npm run i18n:check && npm run typecheck:strict && npm run quality:baseline && npm run quality:gate",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --reporter=line",
    "preview": "vite preview",
    "i18n:status": "node scripts/i18n-manager.mjs status",
    "i18n:sync": "node scripts/i18n-manager.mjs sync",
    "i18n:prep": "node scripts/i18n-manager.mjs prep",
    "i18n:merge": "node scripts/i18n-manager.mjs merge",
    "i18n:check": "node scripts/i18n-manager.mjs check && node scripts/i18n-runtime-structure-check.mjs",
    "i18n:check:all": "node scripts/i18n-manager.mjs fix && node scripts/i18n-runtime-structure-check.mjs --all",
    "i18n:fill": "node scripts/sync-locales-fill-missing.mjs",
    "i18n:check-coverage": "node scripts/check-locale-coverage.mjs",
    "i18n:audit": "node scripts/audit-locales.mjs",
    "i18n:translate-stubs": "node scripts/translate-stubs-from-en.mjs",
    "i18n:translate-stubs:batch": "node scripts/translate-stubs-from-en.mjs --rounds=18 --max=400 --delay=42",
    "i18n:export": "node scripts/i18n-export.mjs",
    "i18n:import": "node scripts/i18n-import.mjs",
    "test": "vitest run",
    "test:scripts": "node --test \"scripts/__tests__/*.test.mjs\"",
    "test:ci": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit",
    "tokens:build": "vite-node scripts/build-tokens.ts",
    "mobile:sync": "npm run build && npx cap sync",
    "mobile:open:android": "npx cap open android",
    "mobile:open:ios": "npx cap open ios",
    "skills:browse": "ai-agent-skills",
    "skills:list": "ai-agent-skills list",
    "skills:doctor": "ai-agent-skills doctor",
    "quality:baseline": "node scripts/quality-baseline-check.mjs",
    "verify:revenue-core:db": "node scripts/verify-revenue-core-db.mjs",
    "docs:audit:freshness": "node scripts/audit-docs-freshness.mjs --scope=docs --days=60",
    "docs:check": "node scripts/validate-doc-links.mjs",
    "predev": "node scripts/generate-sitemap.mjs",
    "prebuild": "node scripts/generate-sitemap.mjs && node scripts/generate-mcp.mjs",
    "format": "prettier --write .",
    "test:watch": "vitest"
